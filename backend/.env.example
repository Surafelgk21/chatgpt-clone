DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_DATABASE=my-gpt
# Set to true only for hosted MySQL that requires SSL
DB_SSL=false
# Free key from https://aistudio.google.com/apikey
API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
# Leave empty to allow all origins; for production use your frontend URL
CORS_ORIGIN=
